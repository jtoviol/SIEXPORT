# DataDownload — Sistema de exportación
# Copiar a .env y ajustar valores

# Modo de operación
USE_MOCK=false                          # true = datos falsos; false = SQL Server real
LIMITE_REGISTROS=25                    # tope NUM_REGISTRO para pruebas

# SQL Server (solo si USE_MOCK=false)
DB_HOST=10.x.x.x
DB_PORT=1433
DB_NAME=seragil
DB_USER=sa
DB_PASSWORD=cambiar-en-.env-real
DB_DRIVER=ODBC Driver 17 for SQL Server

# SQL Server sibacom — módulo Caracterización Familiar (otro servidor)
DB_HOST_SIBACOM=10.x.x.x
DB_PORT_SIBACOM=1433
DB_NAME_SIBACOM=sibacom
DB_USER_SIBACOM=usuario
DB_PASSWORD_SIBACOM=cambiar-en-.env-real

# Paralelismo
LOTE_WORKERS=2                         # lotes simultáneos (1 = secuencial, máx recomendado: 3)

# Almacenamiento
DATA_DIR=./data                        # carpeta donde se guardan los .zip generados
TEMPLATES_DIR=./src/efdi/templates     # ruta a las plantillas
AUTO_CLEANUP_DIAS=0                    # 0 = desactivado. Ej: 60 = borra extracciones
                                        # completadas/falladas/canceladas de hace 60+
                                        # días, una vez al día. Nunca toca jobs activos.

# API
API_HOST=0.0.0.0
API_PORT=8765
LOG_LEVEL=INFO

# Autenticación
AUTH_USER=admin                         # solo crea el primer admin si la tabla users está vacía
AUTH_PASSWORD=                          # sin valor no se crea admin inicial (no hay default)
AUTH_SECRET=                            # firma de cookies. Vacío = se genera en DATA_DIR/.auth_secret
                                        # Para fijarlo: python -c "import secrets; print(secrets.token_hex(32))"
